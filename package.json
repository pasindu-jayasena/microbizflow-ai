{
  "name": "microbizflow-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node scripts/wrangler.mjs dev --config wrangler.worker.toml --local --port 8787",
    "dev:pages": "node scripts/wrangler.mjs pages dev dist/web --d1 DB=00000000-0000-0000-0000-000000000000 --port 8788",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint web/src worker/src shared functions scripts tests/e2e vite.config.ts vitest.config.ts playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:deployment-config": "node --test tests/deployment-config.test.mjs tests/production-owner.test.mjs",
    "test:n8n": "node --test tests/n8n-workflows.test.mjs",
    "check:deployment-config": "node scripts/check-deployment-config.mjs",
    "test:integration:local": "node scripts/smoke-booking.mjs",
    "test:ai:local": "node scripts/smoke-ai.mjs",
    "test:leads:local": "node scripts/smoke-leads.mjs",
    "test:n8n:booking:local": "node scripts/smoke-n8n-booking.mjs",
    "test:workflow:local": "node scripts/smoke-workflow.mjs",
    "test:config:local": "node scripts/smoke-config.mjs",
    "test:customers:local": "node scripts/smoke-customers.mjs",
    "test:analytics:local": "node scripts/smoke-analytics.mjs",
    "test:cancellation:local": "node scripts/smoke-cancellation.mjs",
    "test:webhook:local": "node scripts/smoke-webhook.mjs",
    "test:enquiries:local": "node scripts/smoke-enquiries.mjs",
    "test:privacy:local": "node scripts/smoke-privacy.mjs",
    "test:retention:local": "node scripts/smoke-retention.mjs",
    "test:security:local": "node scripts/smoke-security.mjs",
    "test:scheduled:local": "node scripts/smoke-scheduled.mjs",
    "test:reminders:local": "node scripts/smoke-reminders.mjs",
    "test:followups:local": "node scripts/smoke-followups.mjs",
    "test:automation-tick:local": "node scripts/smoke-automation-tick.mjs",
    "test:crm:local": "node scripts/smoke-crm.mjs",
    "test:demo:local": "node scripts/smoke-demo.mjs",
    "test:e2e": "playwright test",
    "owner:setup:local": "node scripts/setup-owner.mjs",
    "owner:prepare:production": "node scripts/prepare-production-owner.mjs",
    "db:migrate:local": "node scripts/wrangler.mjs d1 migrations apply microbizflow-local --config wrangler.worker.toml --local",
    "db:seed:local": "node scripts/wrangler.mjs d1 execute microbizflow-local --config wrangler.worker.toml --local --file=./db/seed.sql"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.14.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript-eslint": "^8.72.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^4.0.0",
    "wrangler": "^4.160.0"
  },
  "overrides": {
    "minimatch": "^11.0.6"
  }
}
