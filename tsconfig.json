{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "@cloudflare/workers-types", "vitest/globals"]
  },
  "include": ["web/src", "worker/src", "shared", "functions", "vite.config.ts", "vitest.config.ts"]
}
