# Leave blank for the local Vite proxy or same-origin Pages Functions.
# Set only when the API is hosted separately.
VITE_API_BASE_URL=
# Never put owner passwords or other secrets in a Vite environment variable.
# The Worker/Pages server defaults to DEMO_MODE=true and accepts only fictional
# @example.invalid contacts. Keep DEMO_MODE=true for any public portfolio demo.
# Server-only optional binding: WEBHOOK_SECRET (32+ characters).
# Put it in ignored .dev.vars for local tests or a protected Wrangler secret in production.
# Optional server-only lead AI configuration (never set these as VITE_ variables):
# LLM_BASE_URL=https://your-provider.example/v1/
# LLM_MODEL=your-model-name
# LLM_API_KEY=<store only in ignored .dev.vars or a protected Cloudflare secret>
# DRAFT_AI_ENABLED=true enables owner-approved LLM drafts only when a model is configured.
# AUTOMATION_TICK_TOKEN=<32+ random characters, server-only; local n8n credential only>
# CRM_PROVIDER=hubspot
# CRM_EXTERNAL_ENABLED=true (requires DEMO_MODE=false; never set on the public demo)
# HUBSPOT_SERVICE_KEY=<scoped CRM contacts key in ignored .dev.vars or a protected secret>
